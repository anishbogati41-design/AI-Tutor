FROM python:3.13.7-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY backend/requirements.txt backend/requirements-dev.txt /app/backend/
RUN pip install --no-cache-dir -r /app/backend/requirements-dev.txt

COPY backend /app/backend
COPY tests /app/tests

CMD ["sh", "-c", "python -m backend.database.migrate && uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload"]
